  {
   "slug": "checkvist.get_checklists_checklist_id_format",
   "name": "Get a checklist",
   "description": "With `json` or `xml` returns the list representation. This URL also exports the whole list as a document \u2014 `opml`, `md` or `txt` \u2014 controlled by the `export_*` parameters below. OPML is the full-fidelity format: it keeps the whole tree with notes, tags, due dates, assignees, priority/color and open/closed status, and can be fed back to the import call. Pass `export_id=true` to add each item's task",
   "input": {
    "type": "object",
    "properties": {
     "checklist_id": {
      "type": "integer",
      "description": ""
     },
     "format": {
      "type": "string",
      "description": "`json` or `xml` for basic list representation. Also `opml`, `md` or `txt` for other export formats.",
      "enum": [
       "json",
       "xml",
       "opml",
       "md",
       "txt"
      ]
     },
     "with_inbound_email": {
      "type": "boolean",
      "description": "If `true`, include each list's inbound \"email to list\" address as the `inbound_email` field. Omitted by default."
     },
     "export_id": {
      "type": "boolean",
      "description": "`opml` only: add the task ID as the `id` attribute of every ``."
     },
     "export_notes": {
      "type": "boolean",
      "description": "`opml`, `md`: include item notes."
     },
     "export_status": {
      "type": "boolean",
      "description": "`opml` only: include the open/closed/invalid status of every item."
     },
     "export_color": {
      "type": "boolean",
      "description": "`opml` only: include item priority/color."
     },
     "max_heading": {
      "type": "integer",
      "description": "`md` only: turn the first N outline levels into markdown headings, 0..6."
     }
    },
    "required": [
     "checklist_id",
     "format"
    ]
   },
   "request": {
    "method": "GET",
    "url": "https://checkvist.com/checklists/{checklist_id}.{format}",
    "path": [
