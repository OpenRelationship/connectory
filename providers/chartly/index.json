  {
   "slug": "chartly.get_open_chart_render",
   "name": "Open (no auth) chart render \u2014 config in url",
   "description": "Public, unauthenticated chart endpoint. Pass a Chart.js config in the `c` query parameter (URL-encoded JSON) or use the `type` / `data` / `labels` shortcut. Every render carries a small 'chartly.dev' watermark and the `X-Edit-Url` response header points back to the playground. Rate-limited per IP; for production use, get an API key and call /v1/chart instead.",
   "input": {
    "type": "object",
    "properties": {
     "c": {
      "type": "string",
      "description": "URL-encoded Chart.js JSON config"
     },
     "type": {
      "type": "string",
      "description": "Shortcut chart type when not using full config",
      "enum": [
       "bar",
       "line",
       "pie",
       "doughnut"
      ]
     },
     "labels": {
      "type": "string",
      "description": "Shortcut: comma-separated labels (used with type+data)"
     },
     "data": {
      "type": "string",
      "description": "Shortcut: comma-separated numeric values"
     },
     "w": {
      "type": "integer",
      "description": "Width in px, default 500"
     },
     "h": {
      "type": "integer",
      "description": "Height in px, default 300"
     },
     "format": {
      "type": "string",
      "description": "",
      "enum": [
       "png",
       "svg"
      ]
     },
     "bkg": {
      "type": "string",
      "description": "CSS background color, default 'white'"
     }
    },
    "required": []
   },
   "request": {
    "method": "GET",
    "url": "https://api.chartly.dev/v1/open/chart",
    "path": [],
    "query": [
     "c",
     "type",
     "labels",
     "data",
     "w",
     "h",
     "format",
     "bkg"
    ],
    "header": [],
    "body": [],
    "body_format": "json"
   }
